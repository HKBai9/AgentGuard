# Set these in the current process. No automatic dotenv search/loading.
AGENTGUARD_V2_CLOUD_ENABLED=0
AGENTGUARD_GUARD_API_KEY=replace_with_guard_key
AGENTGUARD_AGENT_API_KEY=replace_with_agent_key
AGENTGUARD_HOST_TOKEN=replace_with_unique_host_token
AGENTGUARD_UI_TOKEN=replace_with_different_ui_token
AGENTGUARD_V2_CONFIG=config/v2.example.json
AGENTGUARD_V2_GATEWAY=http://127.0.0.1:8765
AGENTGUARD_V2_SYNTHETIC_UI=0
AGENTGUARD_V2_UI_PORT=8502
# Optional read-only recording/report paths:
# AGENTGUARD_V2_REPLAY=logs/recording.json
# AGENTGUARD_V2_REPORT=logs/v2-evaluation/report.json
# Optional standalone Guard client / earlier cloud_smoke.py:
# AGENTGUARD_V2_API_KEY=
# AGENTGUARD_V2_MODEL=deepseek-chat
# AGENTGUARD_V2_ENDPOINT=https://api.deepseek.com/chat/completions
# AGENTGUARD_V2_PROVIDER=deepseek
# AGENTGUARD_V2_DESTINATION_ID=guard_cloud
# AGENTGUARD_V2_TIMEOUT_SECONDS=30
# AGENTGUARD_V2_CONCURRENCY=2
# AGENTGUARD_V2_RETRIES=1
