# =============================================================================
#  .gitignore
#  ---------------------------------------------------------------------------
#  原则：
#    - 依赖（libs/，约 2.4GB）、运行日志、临时目录   → 不入库
#    - 证据包 experiments/results/DEMO/             → **必须入库**（作品核心证据）
#    - 带时间戳的历史运行结果                        → 不入库（可用命令复现）
#    - sandbox/sandbox_fake/ 下的"假凭证"            → **必须入库**
#      （文件内已标注 DEMO / FAKE，是演示必需的可观测对象）
# =============================================================================

# ---- 运行期产物 ----
logs/
*.log

# ---- 证据与实验结果 ----
# 先忽略所有运行结果，再单独放行固化的 DEMO 证据包
experiments/results/*/
!experiments/results/DEMO/
!experiments/results/DEMO/**

# ---- 依赖与构建产物 ----
libs/
.wheelhouse/
build/
dist/
*.egg-info/
.agentguard-v2/
.venv/
.venv-*/
build/
dist/
*.egg-info/
__pycache__/
*.py[cod]
.pytest_cache/
pytest-cache-files-*/
.ollama_models/
.ollama_home/

# 受限沙箱下可能残留、且无法删除的临时目录
.pi*/
.t2/
.tmp/
.pytest_work/
.pytest_tmp/

# ---- 编辑器 ----
.vscode/
.idea/
*.swp

# ---- 敏感文件兜底 ----
# 只拦"仓库根目录下"的真实密钥，避免误伤沙箱内的演示用假凭证
/*.pem
/*.key
/.env
/.env.v2
/.git-credentials
/.ssh/

# 演示用假凭证必须入库（文件内已标注 DEMO / FAKE）
!sandbox/sandbox_fake/**
