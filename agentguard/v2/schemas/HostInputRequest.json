{
  "$defs": {
    "DataLabels": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "confidentiality": {
          "items": {
            "type": "string"
          },
          "title": "Confidentiality",
          "type": "array"
        },
        "allowed_uses": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Allowed Uses"
        },
        "destination_ids": {
          "anyOf": [
            {
              "items": {
                "maxLength": 200,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_.:-]+$",
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Destination Ids"
        },
        "model_destination_ids": {
          "anyOf": [
            {
              "items": {
                "maxLength": 200,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_.:-]+$",
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Model Destination Ids"
        },
        "integrity": {
          "items": {
            "enum": [
              "trusted_user",
              "host",
              "external",
              "model"
            ],
            "type": "string"
          },
          "title": "Integrity",
          "type": "array"
        },
        "field_restrictions": {
          "additionalProperties": {
            "$ref": "#/$defs/Restrictions"
          },
          "title": "Field Restrictions",
          "type": "object"
        }
      },
      "required": [
        "schema_version",
        "confidentiality",
        "allowed_uses",
        "destination_ids",
        "model_destination_ids",
        "integrity",
        "field_restrictions"
      ],
      "title": "DataLabels",
      "type": "object"
    },
    "Restrictions": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "confidentiality": {
          "items": {
            "type": "string"
          },
          "title": "Confidentiality",
          "type": "array"
        },
        "allowed_uses": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Allowed Uses"
        },
        "destination_ids": {
          "anyOf": [
            {
              "items": {
                "maxLength": 200,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_.:-]+$",
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Destination Ids"
        },
        "model_destination_ids": {
          "anyOf": [
            {
              "items": {
                "maxLength": 200,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_.:-]+$",
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Model Destination Ids"
        }
      },
      "required": [
        "schema_version",
        "confidentiality",
        "allowed_uses",
        "destination_ids",
        "model_destination_ids"
      ],
      "title": "Restrictions",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
