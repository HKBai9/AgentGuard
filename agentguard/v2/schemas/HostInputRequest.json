      "title": "Resource Scope Ids",
      "type": "array"
    },
    "media_type": {
      "enum": [
        "text/plain",
        "application/json"
      ],
      "title": "Media Type",
      "type": "string"
    },
    "synthetic_demo": {
      "title": "Synthetic Demo",
      "type": "boolean"
    }
