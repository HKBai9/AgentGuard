{
  "$defs": {
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "artifact_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Artifact Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "json_pointer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Json Pointer"
        },
        "span": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Span"
        }
      },
      "required": [
        "schema_version",
        "artifact_id",
        "version",
        "sha256",
        "json_pointer",
        "span"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "Message": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "role": {
          "enum": [
            "system",
            "user",
            "assistant",
            "tool"
          ],
          "title": "Role",
          "type": "string"
        },
        "ref": {
          "$ref": "#/$defs/EvidenceRef"
        }
      },
      "required": [
        "schema_version",
        "role",
        "ref"
      ],
      "title": "Message",
      "type": "object"
    },
    "Receipt": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "receipt_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Receipt Id",
          "type": "string"
        },
        "permit_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Permit Id",
          "type": "string"
        },
        "session_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Session Id",
          "type": "string"
        },
        "turn_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Turn Id",
          "type": "string"
        },
        "call_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Call Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "SUCCEEDED",
            "FAILED_KNOWN",
            "UNKNOWN"
          ],
          "title": "Status",
          "type": "string"
        },
        "reason_code": {
          "title": "Reason Code",
          "type": "string"
        },
        "effect_evidence": {
          "additionalProperties": true,
          "title": "Effect Evidence",
          "type": "object"
        },
        "artifact_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvidenceRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "receipt_id",
        "permit_id",
        "session_id",
        "turn_id",
        "call_id",
        "status",
        "reason_code",
        "effect_evidence",
        "artifact_ref",
        "timestamp"
      ],
      "title": "Receipt",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "session_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Session Id",
      "type": "string"
    },
    "recovery_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Recovery Id",
      "type": "string"
    },
    "affected_refs": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "title": "Affected Refs",
      "type": "array"
    },
    "revoked_permit_ids": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_.:-]+$",
        "type": "string"
      },
      "title": "Revoked Permit Ids",
      "type": "array"
    },
    "safe_context_version": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Safe Context Version",
      "type": "string"
    },
    "rebuild_messages": {
      "items": {
        "$ref": "#/$defs/Message"
      },
      "title": "Rebuild Messages",
      "type": "array"
    },
    "required_host_resets": {
      "items": {
        "type": "string"
      },
      "title": "Required Host Resets",
      "type": "array"
    },
    "irreversible_receipts": {
      "items": {
        "$ref": "#/$defs/Receipt"
      },
      "title": "Irreversible Receipts",
      "type": "array"
    },
    "irreversible_final_refs": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "title": "Irreversible Final Refs",
      "type": "array"
    },
    "unknown_receipts": {
      "items": {
        "$ref": "#/$defs/Receipt"
      },
      "title": "Unknown Receipts",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "session_id",
    "recovery_id",
    "affected_refs",
    "revoked_permit_ids",
    "safe_context_version",
    "rebuild_messages",
    "required_host_resets",
    "irreversible_receipts",
    "irreversible_final_refs",
    "unknown_receipts"
  ],
  "title": "RecoveryPlan",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
