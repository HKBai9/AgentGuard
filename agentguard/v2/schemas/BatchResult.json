{
  "$defs": {
    "CallResult": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "risk_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Risk Refs",
          "type": "array"
        },
        "session_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Session Id",
          "type": "string"
        },
        "turn_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Turn Id",
          "type": "string"
        },
        "call_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Call Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "RELEASED",
            "BLOCKED",
            "REVIEW_PENDING",
            "FAILED_KNOWN",
            "UNKNOWN"
          ],
          "title": "Status",
          "type": "string"
        },
        "reason_code": {
          "title": "Reason Code",
          "type": "string"
        },
        "content": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ],
          "title": "Content"
        },
        "artifact_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvidenceRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "receipt": {
          "anyOf": [
            {
              "$ref": "#/$defs/Receipt"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "session_id",
        "turn_id",
        "call_id",
        "status",
        "reason_code",
        "content",
        "artifact_ref",
        "receipt"
      ],
      "title": "CallResult",
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "artifact_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Artifact Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "json_pointer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Json Pointer"
        },
        "span": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Span"
        }
      },
      "required": [
        "schema_version",
        "artifact_id",
        "version",
        "sha256",
        "json_pointer",
        "span"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "Receipt": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "receipt_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Receipt Id",
          "type": "string"
        },
        "permit_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Permit Id",
          "type": "string"
        },
        "session_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Session Id",
          "type": "string"
        },
        "turn_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Turn Id",
          "type": "string"
        },
        "call_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Call Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "SUCCEEDED",
            "FAILED_KNOWN",
            "UNKNOWN"
          ],
          "title": "Status",
          "type": "string"
        },
        "reason_code": {
          "title": "Reason Code",
          "type": "string"
        },
        "effect_evidence": {
          "additionalProperties": true,
          "title": "Effect Evidence",
          "type": "object"
        },
        "artifact_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvidenceRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "receipt_id",
        "permit_id",
        "session_id",
        "turn_id",
        "call_id",
        "status",
        "reason_code",
        "effect_evidence",
        "artifact_ref",
        "timestamp"
      ],
      "title": "Receipt",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "session_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Session Id",
      "type": "string"
    },
    "turn_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Turn Id",
      "type": "string"
    },
    "results": {
      "patternProperties": {
        "^[A-Za-z0-9_.:-]+$": {
          "$ref": "#/$defs/CallResult"
        }
      },
      "propertyNames": {
        "maxLength": 200,
        "minLength": 1
      },
      "title": "Results",
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "session_id",
    "turn_id",
    "results"
  ],
  "title": "BatchResult",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
