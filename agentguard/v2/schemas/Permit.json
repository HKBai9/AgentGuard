{
  "$defs": {
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "artifact_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Artifact Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "json_pointer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Json Pointer"
        },
        "span": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Span"
        }
      },
      "required": [
        "schema_version",
        "artifact_id",
        "version",
        "sha256",
        "json_pointer",
        "span"
      ],
      "title": "EvidenceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "permit_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Permit Id",
      "type": "string"
    },
    "session_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Session Id",
      "type": "string"
    },
    "turn_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Turn Id",
      "type": "string"
    },
    "call_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Call Id",
      "type": "string"
    },
    "tool_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Tool Id",
      "type": "string"
    },
    "tool_manifest_version": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Tool Manifest Version",
      "type": "string"
    },
    "args_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Args Digest",
      "type": "string"
    },
    "artifact_versions": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "title": "Artifact Versions",
      "type": "array"
    },
    "policy_version": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Policy Version",
      "type": "string"
    },
    "context_version": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Context Version",
      "type": "string"
    },
    "relevant_security_revision": {
      "title": "Relevant Security Revision",
      "type": "integer"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "status": {
      "enum": [
        "PROPOSED",
        "REVIEWED",
        "APPROVED",
        "CLAIMED",
        "SUCCEEDED",
        "FAILED_KNOWN",
        "UNKNOWN",
        "REVOKED",
        "EXPIRED"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "permit_id",
    "session_id",
    "turn_id",
    "call_id",
    "tool_id",
    "tool_manifest_version",
    "args_digest",
    "artifact_versions",
    "policy_version",
    "context_version",
    "relevant_security_revision",
    "expires_at",
    "status"
  ],
  "title": "Permit",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
