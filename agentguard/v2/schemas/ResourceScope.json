              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Allowed Uses"
        },
        "destination_ids": {
          "anyOf": [
            {
              "items": {
                "maxLength": 200,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_.:-]+$",
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Destination Ids"
        },
        "model_destination_ids": {
          "anyOf": [
            {
              "items": {
                "maxLength": 200,
