{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "ref_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Ref Id",
          "type": "string"
        },
        "session_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Session Id",
          "type": "string"
        },
        "artifact_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Artifact Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "allowed_uses": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Uses",
          "type": "array"
        },
        "tool_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "type": "string"
          },
          "title": "Tool Ids",
          "type": "array"
        },
        "destination_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "type": "string"
          },
          "title": "Destination Ids",
          "type": "array"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "ref_id",
        "session_id",
        "artifact_id",
        "version",
        "allowed_uses",
        "tool_ids",
        "destination_ids",
        "expires_at"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ToolCall": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "session_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Session Id",
          "type": "string"
        },
        "turn_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Turn Id",
          "type": "string"
        },
        "call_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Call Id",
          "type": "string"
        },
        "tool_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Tool Id",
          "type": "string"
        },
        "manifest_version": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Manifest Version",
          "type": "string"
        },
        "args": {
          "additionalProperties": true,
          "title": "Args",
          "type": "object"
        },
        "input_context_version": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Input Context Version",
          "type": "string"
        },
        "artifact_refs": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Artifact Refs",
          "type": "array"
        },
        "use": {
          "title": "Use",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "session_id",
        "turn_id",
        "call_id",
        "tool_id",
        "manifest_version",
        "args",
        "input_context_version",
        "artifact_refs",
        "use"
      ],
      "title": "ToolCall",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "session_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Session Id",
      "type": "string"
    },
    "turn_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Turn Id",
      "type": "string"
    },
    "context_version": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Context Version",
      "type": "string"
    },
    "calls": {
      "items": {
        "$ref": "#/$defs/ToolCall"
      },
      "title": "Calls",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "session_id",
    "turn_id",
    "context_version",
    "calls"
  ],
  "title": "BatchRequest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
